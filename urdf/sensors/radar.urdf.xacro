<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="radar_sensor">

    <!-- radar Sensor Macro -->
    <xacro:macro name="radar_sensor" params="prefix parent *origin">

        <joint name="${prefix}radar_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${prefix}radar_link"/>
            <xacro:insert_block name="origin" />
        </joint>

        <link name="${prefix}radar_link">
            <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0" />
            <inertia
                ixx="0"
                ixy="0"
                ixz="0"
                iyy="0"
                iyz="0"
                izz="0" />
            </inertial>
        </link>
    </xacro:macro>
</robot>