<?xml version="1.0"?>
<robot name="thigh" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find go2_description)/urdf/leg/calf.urdf.xacro"/>

    <!-- Define a macro for base_link -->
    <xacro:macro name="go2_thigh" params="prefix parent *origin reflect">
        <xacro:property name="calf_offset_x" value="0.0"/>
        <xacro:property name="calf_offset_y" value="0.0"/>
        <xacro:property name="calf_offset_z" value="-0.194"/>

        <joint name="${prefix}thigh_joint" type="continuous">
            <parent link="${parent}"/>
            <child link="${prefix}thigh_link"/>
            <xacro:insert_block name="origin" />
            <axis xyz="0 1 0" />
            <limit lower="-0.5236" upper="4.5379" effort="23.7" velocity="30.1" />
        </joint>

        <link name="${prefix}thigh_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="1.152" />
                <inertia
                    ixx="0.00584"   ixy="8.72E-05"  ixz="-0.000289"
                    iyy="0.0058"    iyz="0.000808"  izz="0.00103"  />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <xacro:unless value="${reflect}">
                        <mesh filename="file://$(find go2_description)/meshes/leg/thigh.dae" scale="1 1 1"/>
                    </xacro:unless>
                    <xacro:if value="${reflect}">
                        <mesh filename="file://$(find go2_description)/meshes/leg/thigh_mirror.dae" scale="1 1 1"/>
                    </xacro:if>
                </geometry>
                <material
                    name="">
                    <color rgba="1 1 1 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <xacro:unless value="${reflect}">
                        <mesh filename="file://$(find go2_description)/meshes/leg/thigh.dae" scale="1 1 1"/>
                    </xacro:unless>
                    <xacro:if value="${reflect}">
                        <mesh filename="file://$(find go2_description)/meshes/leg/thigh_mirror.dae" scale="1 1 1"/>
                    </xacro:if>
                </geometry>
            </collision>
        </link>

        <xacro:go2_calf prefix="${prefix}" parent="${prefix}thigh_link" reflect="${reflect}">
            <origin xyz="${calf_offset_x} ${calf_offset_y} ${calf_offset_z}" rpy="0 0 0"/>
        </xacro:go2_calf>

    </xacro:macro>
</robot>